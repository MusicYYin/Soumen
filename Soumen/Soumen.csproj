<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Author>MusicYYin</Author>
    <Name>Soumen</Name>
    <InternalName>Soumen</InternalName>
    <RootNamespace>Soumen</RootNamespace>
    <Punchline>自动跟随藏宝图队伍旗标。</Punchline>
    <Description>监听队伍坐标链接，在同地图自动上坐骑并通过 vnavmesh 飞往旗标，到达后自动下坐骑。当前版本聚焦 G18 的活着的记忆场景。</Description>
    <RepoUrl>https://github.com/MusicYYin/Soumen</RepoUrl>
    <Tags>treasure;map;navigation;automation;Chinese</Tags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
